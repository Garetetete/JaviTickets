    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^25.0.1",
    "sass-embedded": "^1.81.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
